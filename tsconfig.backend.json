{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "backend/tests/dist",
    "rootDir": "backend",
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["backend/**/*.js", "backend/**/*.ts"],
  "exclude": ["dist", "node_modules", "backend/tests/dist", "utils", "utils/**"]
}
